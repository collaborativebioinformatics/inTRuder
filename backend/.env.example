# Copy to backend/.env and fill in. backend/.env is gitignored — never commit secrets.
#
#   cp backend/.env.example backend/.env

# ---------------------------------------------------------------------------
# Model provider
# ---------------------------------------------------------------------------
# One of: anthropic | claude-code | google | ollama | openai
# Only the Anthropic client is installed by default. For the others, install the
# integration first, e.g.:  cd backend && uv add langchain-google-genai
#
# claude-code runs the agent through the Claude Code CLI already installed on
# this machine, signed in as that CLI, so it needs no key here. See the "Running
# on Claude Code" section of backend/README.md.
LLM_PROVIDER=anthropic

# Leave blank to use the provider's default model.
#   anthropic   -> claude-opus-5
#   claude-code -> whatever Claude Code is configured to use
#   google      -> gemini-2.5-pro
#   ollama      -> llama3.1
#   openai      -> gpt-4o
LLM_MODEL=

# Thinking depth / token spend, on anthropic and claude-code.
# low | medium | high | xhigh | max
LLM_EFFORT=high
# anthropic only — Claude Code manages its own output budget.
LLM_MAX_TOKENS=8000

# ---------------------------------------------------------------------------
# Credentials — set only the one matching LLM_PROVIDER
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# OPENAI_API_KEY=
# claude-code needs no key — it signs in as the Claude Code CLI. Run `claude`
# once in a terminal to log in, and `uv add claude-agent-sdk` to install it.
# Ollama needs no key; set this only if the daemon is not on the default port.
# OLLAMA_BASE_URL=http://localhost:11434

# ---------------------------------------------------------------------------
# Data
# ---------------------------------------------------------------------------
# Root for user data. Manifests may reference it as ${NOVELTRS_DATA_DIR}.
# NOVELTRS_DATA_DIR=/absolute/path/to/data
# Directory scanned for *.yaml dataset manifests.
# NOVELTRS_REGISTRY_DIR=/absolute/path/to/data/web

# ---------------------------------------------------------------------------
# Uploads
# ---------------------------------------------------------------------------
# Files added through the Upload button land in $NOVELTRS_DATA_DIR/uploads, and
# their generated manifests beside the hand-written ones in the registry
# directory. Set this to false to turn the endpoint off entirely.
# UPLOADS_ENABLED=true
# Cap on a single upload, in MB. Enforced as the bytes arrive.
# MAX_UPLOAD_MB=4096
# Extra directories that "read a file already on this machine" may reach. The
# data directory is always allowed; a relative path is read from it. Nothing
# else is, because this endpoint has no authentication in front of it and a
# registered dataset is readable by anyone with the chat box.
# UPLOAD_LINK_ROOTS=/scratch/callsets,/mnt/nas/sv

# ---------------------------------------------------------------------------
# Guardrails on the agent's SQL tool
# ---------------------------------------------------------------------------
MAX_SQL_ROWS=500
SQL_TIMEOUT_S=15

# LLM_PROVIDER=claude-code only: tool-calling turns allowed before it must
# answer. Claude Code runs its own agent loop, so this is the ceiling on the work
# one chat request can do.
CLAUDE_CODE_MAX_TURNS=12

# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Guardrails on the agent's VCF tool
# ---------------------------------------------------------------------------
# The only directory describe_vcf will open a file from; defaults to
# NOVELTRS_DATA_DIR. Paths are resolved through symlinks before being checked
# against it.
# NOVELTRS_VCF_ROOT=/absolute/path/to/data
# Records read before a scan stops and reports itself partial.
VCF_MAX_RECORDS=2000

# ---------------------------------------------------------------------------
# Europe PMC, behind the agent's search_literature tool
# ---------------------------------------------------------------------------
# No API key, and no published quota to code against: the "10 requests/second"
# figure in circulation comes from a forum poster, not from Europe PMC, who
# confirmed only that "the API limit is applied per IP address" and publish no
# number. Responses carry no RateLimit-* or Retry-After headers either.
#
# So the default is half that unofficial figure, and the limiter is process-wide
# rather than per-session — "per IP" means every chat this backend serves shares
# one budget. One question costs about six requests, cached, so 5/s is roughly
# 30x headroom. Raise it only if you know something the docs do not say.
EUROPEPMC_RATE_LIMIT_RPS=5
# Tokens for an initial burst; one query ladder goes out at once.
EUROPEPMC_BURST=8
# Sockets one ladder may open at a time, independent of the rate.
EUROPEPMC_MAX_CONCURRENCY=4
EUROPEPMC_TIMEOUT_S=12
# Responses cached per exact query, so overlapping ladders share rungs.
EUROPEPMC_CACHE_TTL_S=3600
# Hard ceiling on papers handed to the model, whatever it asks for.
LITERATURE_MAX_RESULTS=8
