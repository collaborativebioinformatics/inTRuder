*.py[codz]
*$py.class

# C extensions
*.so

# Distribution / packaging
# Anchored to the repository root with a leading slash. Without it, a bare
# directory name such as `lib/` matches at ANY depth and silently swallows
# unrelated source trees — `frontend/lib/` most notably. Node build output is
# handled by frontend/.gitignore.
.Python
/build/
/develop-eggs/
/dist/
/downloads/
/eggs/
/.eggs/
/lib/
/lib64/
/parts/
/sdist/
/var/
/wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

