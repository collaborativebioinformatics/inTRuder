// ---------------------------------------------------------------------
// MANIFEST
// ---------------------------------------------------------------------
// Metadata about the pipeline itself - shows up when someone runs
// `nextflow info` or looks at run reports. Mostly documentation, but
// good practice.
manifest {
    name            = 'novel-tr-pipeline'
    description     = 'Detect and validate novel tandem repeat insertions from long-read SV calls'
    author          = 'Group 2'
    mainScript      = 'workflows/main.nf'
    nextflowVersion = '>=24.04.0'
    version         = '0.1.0'
}


// ---------------------------------------------------------------------
// DEFAULT PROCESS SETTINGS
// ---------------------------------------------------------------------
// Resource defaults applied to EVERY process unless overridden. You
// can override per-process later (e.g. give FIND_TRS more memory) by
// adding a withName selector - see commented example below.
process {
    cpus   = 2
    memory = '4 GB'
    time   = '1h'

    // Example of overriding settings for one specific process:
    // withName: 'FIND_TRS' {
    //     cpus   = 4
    //     memory = '8 GB'
    // }
}


// ---------------------------------------------------------------------
// EXECUTION PROFILES
// ---------------------------------------------------------------------
// Profiles let you switch how/where the pipeline runs without touching
// main.nf, via: nextflow run main.nf -profile local
// (or -profile conda, -profile docker, etc.)
profiles {
    //TODO-TODO-TODO-TODO THINKING DOCKER ENVIRONMENT
    // Default: run directly on your own machine, using whatever
    // Python/tools are already installed locally.
    local {
        process.executor = 'local'
        params.default_vcf_path = "${projectDir}/../data/sv_output/sniffles/first_500_INS.vcf"
    }

    docker {
    docker.enabled = true
    process.container = 'novel-tr-pipeline:latest'
    params.default_vcf_path = "${projectDir}/../data/sv_output/sniffles/first_500_INS.vcf"
    }

    dnanexus{
        docker.enabled = true
        // TEMPORARY, for testing only: local image tarball uploaded by hand
        // (docker save novel-tr-pipeline:latest). Swap for the GHCR image
        // once ghcr.io/collaborativebioinformatics/intruder/pipeline is public.
        process.container = 'dx://project-JB6zg5Q0pzX96qVJjz7gKg58:file-JB8XZQ00pzX3926V53P2x6v0'
        // TODO: UNCONFIRMED - verify this is actually the right file
        // (correct samples, contains SVTYPE=INS records) before relying
        // on it for real testing.
        params.default_vcf_path = "dx://project-JB6zg5Q0pzX96qVJjz7gKg58:/TRFoutput/Sniffles/HG002_03_04_multisample.vcf"
    }

}


// ---------------------------------------------------------------------
// RUN REPORTING
// ---------------------------------------------------------------------
// These generate human-readable reports every time you run the
// pipeline, written into a reports/ folder. DAG in particular is a nice visual to show
// judges your pipeline's actual structure.
timeline {
    enabled = true
    file    = "reports/timeline.html"
}

report {
    enabled = true
    file    = "reports/report.html"
}

trace {
    enabled = true
    file    = "reports/trace.txt"
}

dag {
    enabled = true
    file    = "reports/pipeline_dag.png"
}