# DNAnexus credentials for `scripts/dx-*.sh`. See docs/DNANexus.md.
#
# Copy to .env and fill in. .env is gitignored; .env.example is not, so never
# put a real token in this file.
#
#     cp .env.example .env && chmod 600 .env
#
# Generate a token at https://platform.dnanexus.com -> Profile -> API Tokens.
# Scope it to the project below with CONTRIBUTE permission: most jobs write
# results back, so a VIEW token authenticates fine and then fails at the last
# step. Prefer a short expiry -- this is a bearer credential stored in cleartext.

DX_API_TOKEN=

# The project everything is billed to and read from. Group2_2026 bills to
# org-baylor_hackathon_2020_sales rather than to you; a project you create
# yourself does not. The id is what actually gets exported -- the name is only
# used to look one up when DX_PROJECT_ID is empty.
DX_PROJECT_NAME=Group2_2026
DX_PROJECT_ID=project-JB6zg5Q0pzX96qVJjz7gKg58
