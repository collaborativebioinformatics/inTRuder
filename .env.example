# DNAnexus credentials for the Evo 2 embedding run.
#
# Copy to .env and fill in. .env is gitignored; .env.example is not, so never
# put a real token in this file.
#
#     cp .env.example .env && chmod 600 .env
#
# Generate a token at https://platform.dnanexus.com -> Profile -> API Tokens.
# Scope it to the Group2_2026 project with CONTRIBUTE permission: the run has
# to write its .npz back, so a VIEW token authenticates but cannot finish the
# job. Prefer a short expiry -- this is a bearer credential stored in cleartext.

DX_API_TOKEN=

# The project holding the SV VCFs and, in /resource, the UCSC TRF track.
DX_PROJECT_NAME=Group2_2026
