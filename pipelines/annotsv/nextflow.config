/*
================================================================================
  Nextflow Configuration — AnnotSV Annotation Pipeline
================================================================================
  Author  : Taimoor
  Project : novelTRs / bcm-hackathon26
  Date    : 2026-08-26
================================================================================
*/

// ============================================================================
// Manifest
// ============================================================================
manifest {
    name            = 'annotsv-nf'
    author          = 'Taimoor'
    description     = 'Nextflow DSL2 pipeline for AnnotSV structural variant annotation'
    version         = '1.0.0'
    nextflowVersion = '>=23.04.0'
    mainScript      = 'main.nf'
}

// ============================================================================
// Global parameters
// ============================================================================
params {
    // --- I/O -----------------------------------------------------------------
    input               = null                  // Glob pattern for input VCF/BED files
    outdir              = 'results'             // Output directory
    publish_dir_mode    = 'copy'                // 'copy', 'symlink', 'link', 'move'

    // --- Reference genome ----------------------------------------------------
    genome_build        = 'GRCh38'              // 'GRCh37' or 'GRCh38'

    // --- AnnotSV installation paths ------------------------------------------
    // The symlink path MUST be used when the real path contains spaces (Tcl
    // limitation).  The symlink /home/taimoor/tools/AnnotSV already exists
    // and points to the actual install directory.
    annotsv_dir         = '/home/taimoor/tools/AnnotSV'

    // Annotations bundled with AnnotSV
    annotations_dir     = '/home/taimoor/tools/AnnotSV/share/AnnotSV'

    // --- Companion tool paths ------------------------------------------------
    bedtools_path       = '/home/taimoor/miniforge3/envs/vardigs/bin/bedtools'
    bcftools_path       = '/home/taimoor/miniforge3/envs/vardigs/bin/bcftools'

    // --- Optional inputs -----------------------------------------------------
    candidate_genes     = null                  // Path to candidate-genes file (optional)

    // --- Pipeline behaviour --------------------------------------------------
    help                = false

    // --- DNAnexus (cloud) ----------------------------------------------------
    // Set these when running on DNAnexus; leave null for local runs.
    dx_project          = null    // DNAnexus project ID
    dx_annotations_path = null    // dx path to AnnotSV annotation databases
                                  // e.g. 'project-XXX:/Reference_Data/AnnotSV'
}

// ============================================================================
// Process defaults
// ============================================================================
process {
    // Default resource allocation
    cpus   = 2
    memory = '8 GB'
    time   = '4 h'

    // Shell options applied to every script block
    shell  = ['/bin/bash', '-euo', 'pipefail']

    // -----------------------------------------------------------------------
    // ANNOTSV-specific overrides
    // -----------------------------------------------------------------------
    withName: 'ANNOTSV' {
        cpus   = 2
        memory = '8 GB'
        time   = '8 h'

        // ext.args  : additional AnnotSV command-line flags injected verbatim
        // ext.prefix: override the output file prefix (defaults to meta.id)
        //
        // Examples:
        //   ext.args   = '-minOverlap 0.7 -typeOfAnnotation split'
        //   ext.prefix = { "${meta.id}_sv" }
        ext.args   = ''
        ext.prefix = null
    }
}

// ============================================================================
// Profiles
// ============================================================================
profiles {

    // ---- Local (default) ---------------------------------------------------
    // Uses tools installed directly on the host; no container or conda env.
    local {
        process.executor    = 'local'
        workDir             = '/tmp/nxf_annotsv_work'
        docker.enabled      = false
        singularity.enabled = false
        conda.enabled       = false

        // Ensure the vardigs conda env binaries are on PATH so AnnotSV can
        // find bedtools / bcftools even without explicit -bedtools / -bcftools
        // flags (the module passes them explicitly, but this is a safety net).
        env.PATH = "/home/taimoor/miniforge3/envs/vardigs/bin:\${PATH}"
    }

    // ---- Conda -------------------------------------------------------------
    conda {
        process.executor    = 'local'
        conda.enabled       = true
        conda.useMamba      = true          // set false if mamba is unavailable
        docker.enabled      = false
        singularity.enabled = false
    }

    // ---- Singularity -------------------------------------------------------
    singularity {
        process.executor            = 'local'
        singularity.enabled         = true
        singularity.autoMounts      = true
        singularity.runOptions      = "--bind /home/taimoor/tools/AnnotSV:/home/taimoor/tools/AnnotSV"
        docker.enabled              = false
        conda.enabled               = false

        // When running inside a container, override tool paths to the
        // container-bundled versions (adjust if using local-mount strategy).
        params.bedtools_path    = 'bedtools'
        params.bcftools_path    = 'bcftools'
        params.annotsv_dir      = '/usr/local/share/AnnotSV'
        params.annotations_dir  = '/usr/local/share/AnnotSV/Annotations_Human'
    }

    // ---- SLURM (HPC cluster example) ---------------------------------------
    slurm {
        process.executor = 'slurm'
        process.queue    = 'normal'
        conda.enabled    = false
        docker.enabled   = false
        singularity.enabled = false

        // Override memory/time for cluster queues
        process {
            withName: 'ANNOTSV' {
                cpus   = 8
                memory = '32 GB'
                time   = '12 h'
            }
        }
    }

    // ---- DNAnexus ----------------------------------------------------------
    // Cloud workers run Docker containers. executor=local from each worker's
    // perspective. Annotations downloaded from dx storage at job start.
    // AnnotSV is at /opt/annotsv in the container (no spaces — Tcl-safe).
    dnanexus {
        docker.enabled          = true
        docker.runOptions       = '-u root --rm'
        process.executor        = 'local'

        params.annotsv_dir          = '/opt/annotsv'
        params.annotations_dir      = '/home/dnanexus/annotations'
        params.bedtools_path        = 'bedtools'
        params.bcftools_path        = 'bcftools'
        params.dx_project           = 'project-JB6zg5Q0pzX96qVJjz7gKg58'
        params.dx_annotations_path  = 'project-JB6zg5Q0pzX96qVJjz7gKg58:/Reference_Data/AnnotSV'
        params.publish_dir_mode     = 'copy'

        process {
            withName: 'ANNOTSV' {
                // Replace YOUR_DOCKERHUB_USERNAME with your Docker Hub username
                // e.g. 'taimoor/annotsv:3.5.10'
                container  = 'YOUR_DOCKERHUB_USERNAME/annotsv:3.5.10'
                cpus       = 4
                memory     = '28 GB'
                time       = '12 h'
            }
        }
    }

    // ---- Test (stub run for CI) --------------------------------------------
    test {
        params.input        = "${projectDir}/test-data/*.vcf"
        params.outdir       = 'test-results'
        params.genome_build = 'GRCh38'
        process.executor    = 'local'
        stubRun             = true
    }
}

// ============================================================================
// Execution tracing & reporting
// ============================================================================
timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/timeline.html"
    overwrite = true
}

report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/report.html"
    overwrite = true
}

trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/trace.txt"
    overwrite = true
}

dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/dag.svg"
    overwrite = true
}
