/*
================================================================================
  AnnotSV Annotation Pipeline — nextflow.config
================================================================================
  Author  : Taimoor
  Project : novelTRs / bcm-hackathon26
  Date    : 2026-08-27
================================================================================
*/

manifest {
    name            = 'novelTRs/annotsv-nf'
    author          = 'Taimoor'
    homePage        = 'https://github.com/collaborativebioinformatics/novelTRs'
    description     = 'Nextflow DSL2 pipeline for SV/TR annotation with AnnotSV'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=23.04.0'
    version         = '1.0.0'
}

// ============================================================================
// Global default parameters
// ============================================================================
params {
    input               = null
    outdir              = 'results'
    genome_build        = 'GRCh38'
    candidate_genes     = null
    publish_dir_mode    = 'copy'
    help                = false

    // Local Tool & Database Defaults (overridden by profiles)
    annotsv_dir         = '/home/taimoor/tools/AnnotSV'
    annotations_dir     = '/home/taimoor/tools/AnnotSV/share/AnnotSV'
    bedtools_path       = '/home/taimoor/miniforge3/envs/vardigs/bin/bedtools'
    bcftools_path       = '/home/taimoor/miniforge3/envs/vardigs/bin/bcftools'

    // DNAnexus Cloud Paths
    dx_project          = 'project-JB6zg5Q0pzX96qVJjz7gKg58'
}

// ============================================================================
// Docker Configuration
// IMPORTANT for DNAnexus Nextaur plugin:
//   - docker.enabled = true triggers Nextaur to spawn child DX jobs with Docker
//   - maxDockerPullAttempts must be declared here (Nextaur reads it at startup)
//   - runOptions and fixOwnership are passed to the Docker run inside child jobs
// ============================================================================
docker {
    enabled               = true
    runOptions            = '-u root --rm'
    fixOwnership          = true
    maxDockerPullAttempts = 3
}

// ============================================================================
// Process defaults
// ============================================================================
process {
    cpus   = 4
    memory = '8 GB'
    time   = '4 h'

    withName: 'ANNOTSV' {
        cpus   = 4
        memory = '8 GB'
        time   = '12 h'
    }

    withName: 'GENERATE_SUMMARY' {
        cpus   = 2
        memory = '4 GB'
        time   = '1 h'
    }
}

// ============================================================================
// Execution Profiles
// ============================================================================
profiles {

    // ---- Local Execution (Host installed tools, no Docker) ------------------
    local {
        process.executor            = 'local'
        workDir                     = '/tmp/nxf_annotsv_work'
        docker.enabled              = false
        singularity.enabled         = false
        conda.enabled               = false
        params.dx_project           = null
        params.annotsv_dir          = '/home/taimoor/tools/AnnotSV'
        params.annotations_dir      = '/home/taimoor/tools/AnnotSV/share/AnnotSV'
        params.bedtools_path        = '/home/taimoor/miniforge3/envs/vardigs/bin/bedtools'
        params.bcftools_path        = '/home/taimoor/miniforge3/envs/vardigs/bin/bcftools'
    }

    // ---- Conda Execution ----------------------------------------------------
    conda {
        process.executor            = 'local'
        conda.enabled               = true
        conda.useMamba              = true
        docker.enabled              = false
        singularity.enabled         = false
        params.dx_project           = null
    }

    // ---- DNAnexus Cloud Execution -------------------------------------------
    // The Nextaur plugin (nextaur v1.x) intercepts local executor tasks and
    // spawns DNAnexus child jobs. Docker is enabled so child jobs pull and run
    // the container image specified by the 'container' directive per-process.
    // process.executor must be 'local' — Nextaur wraps it transparently.
    dnanexus {
        process.executor             = 'local'
        docker.enabled               = true
        docker.runOptions            = '-u root --rm'
        docker.fixOwnership          = true
        docker.maxDockerPullAttempts = 3

        params.dx_project            = 'project-JB6zg5Q0pzX96qVJjz7gKg58'
        params.annotations_dir       = 'dx://project-JB6zg5Q0pzX96qVJjz7gKg58:/resources/AnnotSV'
        params.bedtools_path         = 'bedtools'
        params.bcftools_path         = 'bcftools'
        params.annotsv_dir           = ''
        params.publish_dir_mode      = 'copy'

        process {
            withName: 'ANNOTSV' {
                container = 'quay.io/biocontainers/annotsv:3.5.10--hdfd78af_0'
                cpus   = 8
                memory = '58 GB'
                time   = '24 h'
            }
            withName: 'GENERATE_SUMMARY' {
                container = 'quay.io/biocontainers/annotsv:3.5.10--hdfd78af_0'
                cpus   = 2
                memory = '4 GB'
                time   = '1 h'
            }
        }
    }
}
