/*
================================================================================
  AnnotSV Annotation Pipeline — nextflow.config
================================================================================
  Author  : Taimoor
  Project : novelTRs / bcm-hackathon26
  Date    : 2026-08-27
================================================================================
*/

manifest {
    name            = 'novelTRs/annotsv-nf'
    author          = 'Taimoor'
    homePage        = 'https://github.com/collaborativebioinformatics/novelTRs'
    description     = 'Nextflow DSL2 pipeline for SV/TR annotation with AnnotSV'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=23.04.0'
    version         = '1.0.0'
}

// ============================================================================
// Global default parameters
// ============================================================================
params {
    // Input / Output Configurable Parameters
    input               = '/survivor/HPRC_SV.survivor.vcf'
    outdir              = 'results'
    genome_build        = 'GRCh38'
    candidate_genes     = null
    publish_dir_mode    = 'copy'
    help                = false

    // Pre-Configured Platform Settings (No need to type manually)
    dx_project          = 'project-JB6zg5Q0pzX96qVJjz7gKg58'
    dx_annotations_path = 'project-JB6zg5Q0pzX96qVJjz7gKg58:/resources/AnnotSV'

    // Local Tool Fallbacks
    annotsv_dir         = '/home/taimoor/tools/AnnotSV'
    annotations_dir     = '/home/taimoor/tools/AnnotSV/share/AnnotSV'
    bedtools_path       = 'bedtools'
    bcftools_path       = 'bcftools'
}

// ============================================================================
// Process defaults
// ============================================================================
process {
    cpus   = 4
    memory = '8 GB'
    time   = '4 h'
    shell  = ['/bin/bash', '-euo', 'pipefail']

    withName: 'ANNOTSV' {
        cpus   = 8
        memory = '32 GB'
        time   = '12 h'
    }

    withName: 'GENERATE_SUMMARY' {
        cpus   = 2
        memory = '4 GB'
        time   = '1 h'
    }
}

// ============================================================================
// Execution Profiles
// ============================================================================
profiles {

    // ---- Local Execution (Host installed tools) -----------------------------
    local {
        process.executor            = 'local'
        workDir                     = '/tmp/nxf_annotsv_work'
        docker.enabled              = false
        singularity.enabled         = false
        conda.enabled               = false
        params.dx_project           = null
        params.dx_annotations_path  = null
        env.PATH                    = "/home/taimoor/miniforge3/envs/vardigs/bin:${PATH}"
    }

    // ---- Conda Execution ----------------------------------------------------
    conda {
        process.executor            = 'local'
        conda.enabled               = true
        conda.useMamba              = true
        docker.enabled              = false
        singularity.enabled         = false
        params.dx_project           = null
        params.dx_annotations_path  = null
    }

    // ---- DNAnexus Cloud Execution (Docker Containers) -----------------------
    dnanexus {
        docker.enabled              = true
        docker.runOptions           = '-u root --rm'
        process.executor            = 'local'
        params.dx_project           = 'project-JB6zg5Q0pzX96qVJjz7gKg58'
        params.dx_annotations_path  = 'project-JB6zg5Q0pzX96qVJjz7gKg58:/resources/AnnotSV'
        params.publish_dir_mode     = 'copy'

        process {
            withName: 'ANNOTSV' {
                cpus   = 8
                memory = '64 GB'
                time   = '24 h'
            }
        }
    }
}
