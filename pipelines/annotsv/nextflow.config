/*
================================================================================
  AnnotSV Annotation Pipeline — nextflow.config
================================================================================
  Author  : Taimoor
  Project : novelTRs / bcm-hackathon26
  Date    : 2026-08-27
================================================================================
*/

manifest {
    name            = 'novelTRs/annotsv-nf'
    author          = 'Taimoor'
    homePage        = 'https://github.com/collaborativebioinformatics/novelTRs'
    description     = 'Nextflow DSL2 pipeline for SV/TR annotation with AnnotSV'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=23.04.0'
    version         = '1.0.0'
}

// ============================================================================
// Global default parameters
// ============================================================================
params {
    input               = null
    outdir              = 'results'
    genome_build        = 'GRCh38'
    candidate_genes     = null
    publish_dir_mode    = 'copy'
    help                = false

    // Local Tool & Database Defaults
    annotsv_dir         = '/home/taimoor/tools/AnnotSV'
    annotations_dir     = '/home/taimoor/tools/AnnotSV/share/AnnotSV'
    bedtools_path       = '/home/taimoor/miniforge3/envs/vardigs/bin/bedtools'
    bcftools_path       = '/home/taimoor/miniforge3/envs/vardigs/bin/bcftools'

    // DNAnexus Cloud Paths
    dx_project          = 'project-JB6zg5Q0pzX96qVJjz7gKg58'
}

// ============================================================================
// Process defaults
// ============================================================================
process {
    cpus   = 4
    memory = '8 GB'
    time   = '4 h'
    shell  = ['/bin/bash', '-euo', 'pipefail']

    withName: 'ANNOTSV' {
        cpus   = 4
        memory = '8 GB'
        time   = '12 h'
    }

    withName: 'GENERATE_SUMMARY' {
        cpus   = 2
        memory = '4 GB'
        time   = '1 h'
    }
}

// ============================================================================
// Execution Profiles
// ============================================================================
profiles {

    // ---- Local Execution (Host installed tools) -----------------------------
    local {
        process.executor            = 'local'
        workDir                     = '/tmp/nxf_annotsv_work'
        docker.enabled              = false
        singularity.enabled         = false
        conda.enabled               = false
        params.dx_project           = null
        params.annotsv_dir          = '/home/taimoor/tools/AnnotSV'
        params.annotations_dir      = '/home/taimoor/tools/AnnotSV/share/AnnotSV'
        params.bedtools_path        = '/home/taimoor/miniforge3/envs/vardigs/bin/bedtools'
        params.bcftools_path        = '/home/taimoor/miniforge3/envs/vardigs/bin/bcftools'
    }

    // ---- Conda Execution ----------------------------------------------------
    conda {
        process.executor            = 'local'
        conda.enabled               = true
        conda.useMamba              = true
        docker.enabled              = false
        singularity.enabled         = false
        params.dx_project           = null
    }

    // ---- DNAnexus Cloud Execution (Docker Containers) -----------------------
    dnanexus {
        docker.enabled              = true
        docker.runOptions           = '-u root --rm'
        process.executor            = 'local'
        params.dx_project           = 'project-JB6zg5Q0pzX96qVJjz7gKg58'
        params.annotations_dir      = 'dx://project-JB6zg5Q0pzX96qVJjz7gKg58:/resources/AnnotSV'
        params.bedtools_path        = 'bedtools'
        params.bcftools_path        = 'bcftools'
        params.annotsv_dir          = ''
        params.publish_dir_mode     = 'copy'

        process {
            withName: 'ANNOTSV' {
                container = 'quay.io/biocontainers/annotsv:3.5.10--hdfd78af_0'
                cpus   = 8
                memory = '58 GB'
                time   = '24 h'
            }
            withName: 'GENERATE_SUMMARY' {
                container = 'python:3.10-slim'
                cpus   = 2
                memory = '4 GB'
                time   = '1 h'
            }
        }
    }
}
